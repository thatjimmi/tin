{
  "name": "tin",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "tin",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22.5.0"
      }
    },
    "node_modules/@tin/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@tin/format": {
      "resolved": "packages/format",
      "link": true
    },
    "packages/cli": {
      "name": "@tin/cli",
      "version": "0.0.0",
      "dependencies": {
        "@tin/format": "*"
      },
      "bin": {
        "tin": "src/index.ts"
      }
    },
    "packages/format": {
      "name": "@tin/format",
      "version": "0.0.0"
    }
  }
}
