{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tin",
  "version": "0.0.0",
  "identifier": "dev.tin.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tin",
        "width": 960,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "fileAssociations": [
      {
        "ext": ["tin"],
        "name": "Tin Document",
        "description": "A tin app file: SQLite bundle of HTML, data, and files",
        "role": "Editor"
      }
    ]
  }
}
